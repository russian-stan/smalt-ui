{
  // Separate project for Playwright: specs and config run under Node, so Node types are
  // enabled here (tsconfig.base disables them with "types": []).
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
